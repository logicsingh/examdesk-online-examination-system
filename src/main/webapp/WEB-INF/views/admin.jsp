<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,edu.bsc.exam.Html" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administration · ExamDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="nav.jspf" %><main class="container"><div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Users and subjects</h1><p class="muted">Assign roles and maintain the subject catalogue.</p></div></div><% if(request.getParameter("message")!=null){ %><div class="alert success"><%=Html.escape(request.getParameter("message"))%></div><% } %>
<section class="panel"><h2>Add a subject</h2><form method="post" action="<%=request.getContextPath()%>/admin/subjects" class="inline-form"><label>Subject code<input name="code" maxlength="20" required placeholder="CS301"></label><label>Subject name<input name="name" maxlength="120" required placeholder="Database Management Systems"></label><button class="button primary">Add subject</button></form></section><section class="panel table-panel"><h2>User accounts</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Change role</th></tr></thead><tbody><% for(Map<String,Object>u:(List<Map<String,Object>>)request.getAttribute("users")){ %><tr><td><%=Html.escape((String)u.get("name"))%></td><td><%=Html.escape((String)u.get("email"))%></td><td><span class="status published"><%=u.get("role")%></span></td><td><form method="post" action="<%=request.getContextPath()%>/admin/users" class="inline-form"><input type="hidden" name="userId" value="<%=u.get("id")%>"><select name="role"><% for(String role:List.of("STUDENT","FACULTY","ADMIN")){ %><option <%=role.equals(u.get("role"))?"selected":""%>><%=role%></option><% } %></select><button class="button small secondary">Save</button></form></td></tr><% } %></tbody></table></div></section></main><%@ include file="footer.jspf" %></body></html>
