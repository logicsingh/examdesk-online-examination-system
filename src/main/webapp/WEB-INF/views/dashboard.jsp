<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,edu.bsc.exam.User,edu.bsc.exam.Html" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard · ExamDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="nav.jspf" %><main class="container"><% User user=(User)session.getAttribute("user"); List<Map<String,Object>> exams=(List<Map<String,Object>>)request.getAttribute("exams"); %>
<div class="page-heading"><div><p class="eyebrow">YOUR WORKSPACE</p><h1>Welcome, <%=Html.escape(user.name())%></h1><p class="muted">Review available assessments and track your completed attempts.</p></div><span class="pill"><%=user.role()%></span></div><section class="stats"><article class="stat"><span>Published assessments</span><strong><%=exams.size()%></strong><small>Available in the system</small></article><article class="stat"><span>Completed attempts</span><strong><%=request.getAttribute("attemptCount")%></strong><small>Your submitted assessments</small></article><article class="stat"><span>Account role</span><strong class="role-value"><%=user.role()%></strong><small>Access is role controlled</small></article></section>
<div class="section-heading"><div><h2>Published assessments</h2><p class="muted">Each student can start one attempt per assessment.</p></div><a class="button secondary" href="<%=request.getContextPath()%>/results">View results</a></div><div class="exam-grid">
<% if(exams.isEmpty()){ %><div class="empty-state"><h3>No published exams yet</h3><p>Faculty-created assessments will appear here.</p></div><% } else { for(Map<String,Object> e:exams){boolean attempted=(Boolean)e.get("attempted");%><article class="exam-card"><div class="exam-top"><span class="subject-tag"><%=Html.escape((String)e.get("subject"))%></span><span class="dot-status"><%=attempted?"Attempt started":"Available"%></span></div><h3><%=Html.escape((String)e.get("title"))%></h3><div class="exam-meta"><span><%=e.get("duration")%> min</span><span><%=e.get("marks")%> marks</span></div><a class="button <%=attempted?"secondary":"primary"%> full" href="<%=request.getContextPath()%>/<%=attempted?"exams/take":"exams/start"%>?id=<%=e.get("id")%>"><%=attempted?"Open attempt":"Start exam"%></a></article><% }} %></div>
<% if("FACULTY".equals(user.role())||"ADMIN".equals(user.role())){ %><div class="callout"><div><strong>Faculty workspace</strong><p>Create assessments, manage questions and publish exams.</p></div><a class="button secondary" href="<%=request.getContextPath()%>/faculty/exams">Manage exams</a></div><% } if("ADMIN".equals(user.role())){ %><div class="callout"><div><strong>Administration</strong><p>Manage user roles and subjects.</p></div><a class="button secondary" href="<%=request.getContextPath()%>/admin">Open administration</a></div><% } %>
</main><%@ include file="footer.jspf" %></body></html>
