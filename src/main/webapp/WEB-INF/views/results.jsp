<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,edu.bsc.exam.Html" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Results · ExamDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="nav.jspf" %><main class="container"><div class="page-heading"><div><p class="eyebrow">ASSESSMENT HISTORY</p><h1>Your results</h1><p class="muted">Submitted assessments and automatically calculated scores.</p></div><a class="button secondary" href="<%=request.getContextPath()%>/dashboard">Dashboard</a></div><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Assessment</th><th>Subject</th><th>Score</th><th>Submitted</th><th>Status</th></tr></thead><tbody><% List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("results");if(rows.isEmpty()){ %><tr><td colspan="5" class="empty-cell">No completed assessments yet.</td></tr><% }else for(Map<String,Object>r:rows){ %><tr><td><strong><%=Html.escape((String)r.get("title"))%></strong></td><td><%=Html.escape((String)r.get("subject"))%></td><td><strong><%=r.get("score")%> / <%=r.get("max")%></strong></td><td><%=r.get("submitted")%></td><td><span class="status submitted"><%=r.get("status")%></span></td></tr><% } %></tbody></table></div></section></main><%@ include file="footer.jspf" %></body></html>
